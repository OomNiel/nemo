#!/usr/bin/make -f

# Force UTF8 to workaround build error
export LC_ALL=C.UTF-8

CONFIGURE_EXTRA_FLAGS = \
	--libexecdir=/usr/lib/$(DEB_HOST_MULTIARCH)/nemo \
	--buildtype=debugoptimized \
	-D deprecated_warnings=false \
	-D gtk_doc=true \
	-D gtk_layer_shell=true \
	-D selinux=false

export DEB_LDFLAGS_MAINT_APPEND = -Wl,-z,defs -Wl,-O1 -Wl,--as-needed
export DEB_BUILD_MAINT_OPTIONS = hardening=+bindnow
export DPKG_GENSYMBOLS_CHECK_LEVEL = 2

%:
	dh $@ --with gir

override_dh_auto_configure:
	dh_auto_configure -- $(CONFIGURE_EXTRA_FLAGS)

override_dh_auto_install:
	dh_auto_install
	# Copy dependency .gir files into staging for dh_girepository
	for gir in /home/niel/nemo-prefix/usr/share/gir-1.0/*.gir; do \
		cp -n "$$gir" $(CURDIR)/debian/tmp/usr/share/gir-1.0/ 2>/dev/null || true; \
	done
	# Compile .gir files to .typelib into staging
	for gir in $(CURDIR)/debian/tmp/usr/share/gir-1.0/*.gir; do \
		g-ir-compiler "$$gir" -o "$${gir%.gir}.typelib" 2>/dev/null || true; \
	done

override_dh_girepository:
	# Copy dependency .gir/.typelib to all package staging dirs for dh_girepository
	for pkg in $$(dh_listpackages); do \
		mkdir -p debian/$$pkg/usr/share/gir-1.0 debian/$$pkg/usr/lib/x86_64-linux-gnu/girepository-1.0; \
		cp -n /home/niel/nemo-prefix/usr/share/gir-1.0/*.gir debian/$$pkg/usr/share/gir-1.0/ 2>/dev/null || true; \
		cp -n /home/niel/nemo-prefix/usr/lib/x86_64-linux-gnu/girepository-1.0/*.typelib debian/$$pkg/usr/lib/x86_64-linux-gnu/girepository-1.0/ 2>/dev/null || true; \
	done
	dh_girepository /home/niel/nemo-prefix/usr/lib/x86_64-linux-gnu /home/niel/nemo-prefix/usr/lib/x86_64-linux-gnu/girepository-1.0 /home/niel/nemo-prefix/usr/share/gir-1.0
	# Remove dependency .gir/.typelib files (keep only Nemo's)
	for pkg in $$(dh_listpackages); do \
		for gir in debian/$$pkg/usr/share/gir-1.0/*.gir; do \
			base=$$(basename "$$gir"); \
			[ "$$base" != "Nemo-3.0.gir" ] && rm -f "$$gir"; \
		done; \
		for typ in debian/$$pkg/usr/lib/x86_64-linux-gnu/girepository-1.0/*.typelib; do \
			base=$$(basename "$$typ"); \
			[ "$$base" != "Nemo-3.0.typelib" ] && rm -f "$$typ"; \
		done; \
	done

override_dh_auto_test:
	# Disabled
	:

override_dh_strip:
	dh_strip --dbg-package=nemo-dbg

override_dh_python3:
	dh_python3 -p nemo-data /usr/share/nemo

# workaround for fix lmde4 build
override_dh_dwz:
	# Disabled
	:
